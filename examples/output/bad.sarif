          }
        },
        {
          "ruleId": "currency-mismatch",
          "ruleIndex": 22,
          "level": "error",
          "message": {
            "text": "The currency of phase holders is SOL, a currency of Solana, but the collection is ERC-721, on an EVM chain. This is a best practice of this tool, not a rule in the pages it cites. Fix: Price the phase in a currency of the chain of the collection, or correct the standard."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 9,
                  "startColumn": 73
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "subject": "holders"
          }
        },
        {
          "ruleId": "field-missing",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Phase PUBLIC has no currency, such as ETH or SOL. Fix: Add the field named; docs/inputs.md lists what the plan needs."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
