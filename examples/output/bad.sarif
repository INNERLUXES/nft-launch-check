          "message": {
            "text": "The royalty is 1,250 basis points (12.5%) but names no receiver. The royaltyInfo of ERC-2981 answers a marketplace with the address the royalty is sent to, and a royalty with no receiver has nowhere to go. Fix: Name the receiver of the royalty, such as the multisig of the team or a contract that splits it, or set the royalty to 0."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
