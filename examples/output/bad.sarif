          }
        },
        {
          "ruleId": "phase-empty",
          "ruleIndex": 7,
          "level": "error",
          "message": {
            "text": "Phase holders starts at minute 4,320 and ends at minute 4,320, so it is open for no minute. This is a best practice of this tool, not a rule in the pages it cites. Fix: Set the end of the phase after its start, in the timing of the plan."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
