        },
        {
          "ruleId": "field-unknown",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "The key \"perWalletLimt\" of phase 1 is not one the tool reads, so its value was left out of every check. Did you mean \"perWalletLimit\"? The keys of phase 1 are name, start, end, price, currency, perWalletLimit, supplyCap, allowList, notes. Fix: Correct the spelling to a field of docs/inputs.md, or remove it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 91
                }
              }
            }
          ],
          "properties": {
            "kind": "input",
            "subject": null
          }
        },
        {
          "ruleId": "allowlist-oversubscribed",
          "ruleIndex": 10,
          "level": "warning",
          "message": {
            "text": "The allow list of phase allowlist holds 1,500 wallets, but the phase is capped at 1,000, so some listed wallets may find it sold out. This is a best practice of this tool, not a rule in the pages it cites. Fix: Raise the supply cap of the phase, lower the per-wallet limit or the size of the list, or tell the listed wallets that a place on the list does not hold a token."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
                  "index": 0
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 145
                }
              }
            }
          ],
          "properties": {
            "kind": "best practice",
            "subject": "allowlist"
          }
        },
        {
          "ruleId": "public-phase-unlimited",
          "ruleIndex": 11,
          "level": "warning",
          "message": {
            "text": "Phase public is open to every wallet and free, with no perWalletLimit, so one wallet, or a set of bots, can mint as much of it as it can pay for. This is a best practice of this tool, not a rule in the pages it cites. Fix: Set perWalletLimit on every public phase, above all on a free or cheap one, and keep in mind that a limit per wallet does not stop one person with many wallets."
