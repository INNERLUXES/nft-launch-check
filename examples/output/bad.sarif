          "ruleIndex": 21,
          "level": "error",
          "message": {
            "text": "The minter of the admin roles, \"0x12345\", has 5 characters after 0x, not 40; an address of an EVM chain is 0x followed by 40 hex digits. This is a best practice of this tool, not a rule in the pages it cites. Fix: Copy the address again from the wallet; send nothing to a zero address, which no one holds."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/bad/plan.json",
